JWT_SECRET=            # at least 32 random chars, e.g. `openssl rand -hex 32`
OPENAI_API_KEY=
MAIL_USERNAME=
MAIL_PASSWORD=         # Gmail app password
MAIL_FROM=
PAYOS_ENABLED=false
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
